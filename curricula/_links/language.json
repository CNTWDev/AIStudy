  {
   "from": "ESH-REA-13",
   "to": "CHN-JZ-05",
   "type": "context",
   "note": "读英文诗歌小说时分析修辞的作用，和语文分析修辞表达效果的思路相同"
  },
  {
   "from": "ENG-WRI-19",
   "to": "CHN-WT-11",
   "type": "context",
   "note": "英语议论文的观点、理由和例子，对应语文议论文的论点和论据"
