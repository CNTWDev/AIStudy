# AIStudy 服务器配置。install.sh 会自动从这个文件生成 .env 并填好 SECRET_KEY 和 DATABASE_URL。
# .env 里有密码，不要提交到 git（已在 .gitignore 里）。
# AI（Claude 等大模型）的配置不在这里，在 config/llm.toml。

# 用于加密登录 cookie 的随机长字符串（install.sh 自动生成）
SECRET_KEY=请改成一串随机字符

# 数据库。生产用 PostgreSQL（install.sh 自动创建并填写）；本地试用可以用 SQLite：sqlite:///data/aistudy.db
DATABASE_URL=sqlite:///data/aistudy.db

# 对外访问地址（用于生成重设密码链接），例如 https://study.example.com
PUBLIC_URL=

# 走 HTTPS 时设为 1（install.sh 带 --domain 时自动设置）
HTTPS_ONLY=0

# 家长账号怎么注册：
#   approval = 有邀请码直接开通；没有邀请码也可以申请，管理员在「管理 → 待审批」通过后才能登录（默认）
#   invite   = 必须有邀请码
#   open     = 任何人都能注册
#   closed   = 只能由管理员在「管理」页创建
# 无论哪种，第一个注册的账号都是管理员（不需要邀请码）；孩子账号都由家长创建。
REGISTRATION=approval
# 每个家长最多同时持有几个未用完的邀请码（家长可以邀请亲友；管理员不限）
PARENT_INVITE_LIMIT=3

# 密码最少位数；连续输错几次锁定、锁定几分钟；登录保持几天
PASSWORD_MIN_LEN=6
LOGIN_MAX_FAILS=5
LOGIN_LOCK_MINUTES=15
SESSION_DAYS=60

# 数据库连接池大小（每个进程）
DB_POOL_SIZE=10

TZ_NAME=Asia/Shanghai

# 「问一问」小助手的名字和图标（孩子页面右下角的提问按钮）。可以换成和自家孩子有关的名字
# ASSISTANT_NAME=小艾
# ASSISTANT_ICON=🙋
